<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ draws its own system splash (icon centered). The user asked to
     remove the logo shown when the app opens — so on API 31+ we paint the
     splash in the app sky color and hide the system icon with a transparent
     drawable. Below API 31 the plain @drawable/splash (solid color) is used. -->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#78C8F8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
