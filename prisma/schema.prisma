generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artwork {
  id         Int      @id @default(autoincrement())
  title      String
  image      String
  state      String   @default("{}")
  templateId String   @default("")
  stars      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
